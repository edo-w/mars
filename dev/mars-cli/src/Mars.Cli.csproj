<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <!-- System.CommandLine.Command implements nongeneric IEnumerable. -->
    <NoWarn>$(NoWarn);CA1010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../../mars-core/src/Mars.Core.csproj" />
    <ProjectReference Include="../../mars-local/src/Mars.Local.csproj" />
  </ItemGroup>
</Project>
